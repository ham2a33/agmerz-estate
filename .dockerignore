# dependencies
node_modules
.pnp
.pnp.js

# build output
.next
out
build
dist

# git
.git
.gitignore

# env / secrets
.env
.env.*
!.env.example

# tests / coverage
coverage
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor / OS
.DS_Store
*.pem
.vscode
