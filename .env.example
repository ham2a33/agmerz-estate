# PostgreSQL (Docker Compose / Dokploy)
POSTGRES_USER=agmerz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agmerz_estate

# Prisma — use Docker service hostname `postgres` in production
DATABASE_URL=postgresql://agmerz:change-me@postgres:5432/agmerz_estate?schema=public

# Admin authentication (set strong values in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Runtime
NODE_ENV=production

# Local development only — override DATABASE_URL when running Next.js outside Docker:
# DATABASE_URL=postgresql://agmerz:change-me@localhost:5432/agmerz_estate?schema=public
# NODE_ENV=development
